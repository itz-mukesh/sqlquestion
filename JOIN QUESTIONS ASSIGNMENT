mysql> -- Example 6: Advanced filtering with aggregation
mysql> -- Find customers who haven't ordered in the past 30 days ;
mysql> -- Example 6: Advanced filtering with aggregation
mysql> -- Find customers who haven't ordered in the past 30 days
mysql> SELECT 
    ->     c.customer_id,
    ->     c.customer_name,
    ->     MAX(o.order_date) AS last_order_date
    -> FROM 
    ->     customers c
    -> LEFT JOIN 
    ->     orders o ON c.customer_id = o.customer_id
    -> GROUP BY 
    ->     c.customer_id, c.customer_name
    -> HAVING 
    ->     MAX(o.order_date) IS NULL 
    ->     OR MAX(o.order_date) < DATE_SUB(CURDATE(), INTERVAL 30 DAY);
