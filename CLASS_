CREATE DATABASE WINDOWS;

USE WINDOWS;


/**
WINDOW FUNCTION ARE THE FUNCTION WHICH ARE USE TO PERFORM THE CALCULATION SET OF ROWS 
THESE CALCULATION ARE DONE IN RELATION TO THE CURRENT ROW
WINDOW FUNCTION DONOT COLLAPS THE DATA LIKE GROUP BY 

OVER (SET OF ROWS ) - COMPULSERY - ALL ROWS


**/


-- OVER - 3 OPTIONS

